# ============================================================================
# Instagram Reel Scraper - Production Environment Configuration
# ============================================================================
#
# IMPORTANT: This is a template file. Copy it to .env and fill in actual values.
#
# Steps:
#   1. Copy this file: cp .env.production.example /opt/instagram-scraper/.env
#   2. Edit the .env file with your production values
#   3. Generate SECRET_KEY: openssl rand -hex 32
#   4. Use strong passwords (20+ characters)
#   5. Set correct ALLOWED_ORIGINS for your domain
#   6. Never commit .env to version control
#
# ============================================================================

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
#
# CHANGE THESE VALUES:
DATABASE_URL=postgresql://scraper_user:YOUR_STRONG_PASSWORD_HERE@localhost:5432/instagram_scraper

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=scraper_user
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD_HERE
POSTGRES_DB=instagram_scraper

# ----------------------------------------------------------------------------
# JWT Authentication
# ----------------------------------------------------------------------------
# Generate SECRET_KEY with: openssl rand -hex 32
# This is critical for security - MUST be random and secret!
#
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY_FROM_OPENSSL
ALGORITHM=HS256

# Token expiration in minutes (10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------
# Environment mode
ENVIRONMENT=production

# Debug mode (MUST be False in production)
DEBUG=False

# CORS allowed origins (comma-separated)
# Replace with your actual domain(s)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Maximum requests per minute (rate limiting)
MAX_REQUESTS_PER_MINUTE=60

# Maximum groups per user
MAX_GROUPS_PER_USER=100

# ----------------------------------------------------------------------------
# Instagram Configuration (Optional)
# ----------------------------------------------------------------------------
# Instagram account credentials for scraping (if needed)
# Leave empty if using cookie-based authentication
#
INSTAGRAM_EMAIL=
INSTAGRAM_PASSWORD=

# API key for cookie updater script
# Generate with: python Backend/generate_api_key.py create "Cookie Updater"
COOKIE_UPDATER_API_KEY=

# ----------------------------------------------------------------------------
# Server Configuration (Optional)
# ----------------------------------------------------------------------------
# Server host and port (usually handled by uvicorn command)
# HOST=0.0.0.0
# PORT=8080

# Number of uvicorn workers (usually 2x CPU cores)
# WORKERS=4

# ----------------------------------------------------------------------------
# Logging Configuration (Optional)
# ----------------------------------------------------------------------------
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file locations
LOG_FILE=/opt/instagram-scraper/logs/app.log
ERROR_LOG_FILE=/opt/instagram-scraper/logs/error.log

# ----------------------------------------------------------------------------
# APScheduler Configuration (Optional)
# ----------------------------------------------------------------------------
# Timezone for scheduled tasks (daily credit reset)
SCHEDULER_TIMEZONE=Asia/Kolkata

# Daily reset time (24-hour format: HH:MM)
DAILY_RESET_TIME=00:00

# ----------------------------------------------------------------------------
# Security Headers (Optional)
# ----------------------------------------------------------------------------
# Enable security headers
ENABLE_SECURITY_HEADERS=True

# Content Security Policy
# CSP_DIRECTIVES=default-src 'self'; script-src 'self' 'unsafe-inline'

# ----------------------------------------------------------------------------
# Monitoring & Analytics (Optional)
# ----------------------------------------------------------------------------
# Sentry DSN for error tracking
# SENTRY_DSN=

# Google Analytics ID
# GA_TRACKING_ID=

# ----------------------------------------------------------------------------
# Backup Configuration (Optional)
# ----------------------------------------------------------------------------
# Backup directory
BACKUP_DIR=/opt/instagram-scraper/backups

# Backup retention days
BACKUP_RETENTION_DAYS=30

# ----------------------------------------------------------------------------
# Email Configuration (Optional - for notifications)
# ----------------------------------------------------------------------------
# SMTP server settings
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# ----------------------------------------------------------------------------
# Redis Configuration (Optional - for caching/job queue)
# ----------------------------------------------------------------------------
# Redis connection URL
# REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------------------------
# Notes
# ----------------------------------------------------------------------------
#
# 1. Security Checklist:
#    ✓ Change SECRET_KEY to a random 32-byte hex string
#    ✓ Use strong database password (20+ characters)
#    ✓ Set DEBUG=False in production
#    ✓ Restrict ALLOWED_ORIGINS to your domain only
#    ✓ Never commit .env to version control
#    ✓ Limit file permissions: chmod 600 /opt/instagram-scraper/.env
#
# 2. Performance Tuning:
#    - Adjust WORKERS based on CPU cores (2x cores recommended)
#    - Tune MAX_REQUESTS_PER_MINUTE based on load
#    - Monitor database connections
#
# 3. Monitoring:
#    - Set up error tracking (Sentry)
#    - Configure log rotation
#    - Enable uptime monitoring
#    - Setup database backups
#
# ============================================================================
